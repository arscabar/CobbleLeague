{
  "schemaVersion": 1,
  "id": "cobbleleague",
  "version": "${version}",
  "name": "CobbleLeague",
  "description": "Ready lobby dungeon matches, native temporary parties, private selection rooms and Quick Teams battles.",
  "environment": "*",
  "license": "MIT",
  "entrypoints": {
    "main": [
      "dev.cobbleleague.LeagueMod"
    ],
    "client": [
      "dev.cobbleleague.client.LeagueClient"
    ]
  },
  "mixins": [
    "cobbleleague.mixins.json",
    {
      "config": "cobbleleague.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.6+kotlin.2.2.20",
    "cobblemon": "1.7.3"
  },
  "suggests": {
    "cobblemon_quick_teams": "*"
  }
}